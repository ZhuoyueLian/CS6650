{
  "family": "splitter-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::767397760709:role/LabRole",
  "taskRoleArn": "arn:aws:iam::767397760709:role/LabRole",
  "containerDefinitions": [
    {
      "name": "splitter-container",
      "image": "767397760709.dkr.ecr.us-west-2.amazonaws.com/splitter-service:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ]
}
