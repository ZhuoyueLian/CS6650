# Wire together modules: network, ecr, logging, rds, dynamodb, alb, ecs services

module "network" {
  source         = "./modules/network"
  service_name   = var.service_name
  container_port = var.container_port
}

module "ecr" {
  source          = "./modules/ecr"
  repository_name = var.ecr_repository_name
}

# ECR for DynamoDB service
module "ecr_dynamodb" {
  source          = "./modules/ecr"
  repository_name = "${var.ecr_repository_name}-dynamodb"
}

module "logging" {
  source            = "./modules/logging"
  service_name      = var.service_name
  retention_in_days = var.log_retention_days
}

# Logging for DynamoDB service
module "logging_dynamodb" {
  source            = "./modules/logging"
  service_name      = "${var.service_name}-dynamodb"
  retention_in_days = var.log_retention_days
}

# Get VPC ID for ALB and RDS
data "aws_vpc" "default" {
  default = true
}

# RDS MySQL Database
module "rds" {
  source = "./modules/rds"

  service_name           = var.service_name
  vpc_id                 = data.aws_vpc.default.id
  subnet_ids             = module.network.subnet_ids
  ecs_security_group_ids = [module.network.security_group_id]
  database_name          = var.db_name
  master_username        = var.db_username
  master_password        = var.db_password
}

# DynamoDB Table
module "dynamodb" {
  source       = "./modules/dynamodb"
  service_name = var.service_name
}

# Reuse an existing IAM role for ECS tasks
data "aws_iam_role" "lab_role" {
  name = "LabRole"
}

# Application Load Balancer for MySQL service
module "alb" {
  source             = "./modules/alb"
  service_name       = var.service_name
  container_port     = var.container_port
  vpc_id             = data.aws_vpc.default.id
  subnet_ids         = module.network.subnet_ids
  security_group_ids = [module.network.security_group_id]
}

# Application Load Balancer for DynamoDB service
module "alb_dynamodb" {
  source             = "./modules/alb"
  service_name       = "${var.service_name}-dynamodb"
  container_port     = var.container_port
  vpc_id             = data.aws_vpc.default.id
  subnet_ids         = module.network.subnet_ids
  security_group_ids = [module.network.security_group_id]
}

# ECS with Auto Scaling - MySQL Service
module "ecs" {
  source             = "./modules/ecs"
  service_name       = var.service_name
  image              = "${module.ecr.repository_url}:latest"
  container_port     = var.container_port
  subnet_ids         = module.network.subnet_ids
  security_group_ids = [module.network.security_group_id]
  execution_role_arn = data.aws_iam_role.lab_role.arn
  task_role_arn      = data.aws_iam_role.lab_role.arn
  log_group_name     = module.logging.log_group_name
  ecs_count          = var.min_capacity
  region             = var.aws_region

  # Database connection environment variables
  environment_variables = [
    {
      name  = "DB_HOST"
      value = module.rds.db_instance_address
    },
    {
      name  = "DB_PORT"
      value = tostring(module.rds.db_instance_port)
    },
    {
      name  = "DB_NAME"
      value = module.rds.db_name
    },
    {
      name  = "DB_USER"
      value = var.db_username
    },
    {
      name  = "DB_PASSWORD"
      value = var.db_password
    }
  ]

  # Auto Scaling configuration
  enable_autoscaling = true
  min_capacity       = var.min_capacity
  max_capacity       = var.max_capacity
  cpu_target_value   = var.cpu_target_value
  target_group_arn   = module.alb.target_group_arn
}

# ECS with Auto Scaling - DynamoDB Service
module "ecs_dynamodb" {
  source             = "./modules/ecs"
  service_name       = "${var.service_name}-dynamodb"
  image              = "${module.ecr_dynamodb.repository_url}:latest"
  container_port     = var.container_port
  subnet_ids         = module.network.subnet_ids
  security_group_ids = [module.network.security_group_id]
  execution_role_arn = data.aws_iam_role.lab_role.arn
  task_role_arn      = data.aws_iam_role.lab_role.arn
  log_group_name     = module.logging_dynamodb.log_group_name
  ecs_count          = var.min_capacity
  region             = var.aws_region

  # DynamoDB environment variables
  environment_variables = [
    {
      name  = "DYNAMODB_TABLE"
      value = module.dynamodb.table_name
    },
    {
      name  = "AWS_REGION"
      value = var.aws_region
    }
  ]

  # Auto Scaling configuration
  enable_autoscaling = true
  min_capacity       = var.min_capacity
  max_capacity       = var.max_capacity
  cpu_target_value   = var.cpu_target_value
  target_group_arn   = module.alb_dynamodb.target_group_arn
}

# Build & push the MySQL app image into ECR
resource "docker_image" "app" {
  name = "${module.ecr.repository_url}:latest"

  build {
    context = "../src"
  }
}

resource "docker_registry_image" "app" {
  name = docker_image.app.name
}

# Build & push the DynamoDB app image into ECR
resource "docker_image" "app_dynamodb" {
  name = "${module.ecr_dynamodb.repository_url}:latest"

  build {
    context = "../src-dynamodb"
  }
}

resource "docker_registry_image" "app_dynamodb" {
  name = docker_image.app_dynamodb.name
}